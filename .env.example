# =====================================================================
# CONTADORES EIRL - Variables de entorno (plantilla)
# Copia este archivo a ".env" (o a los .env de cada módulo). NUNCA subas ".env".
# =====================================================================

# --- Supabase: valores PÚBLICOS (seguros para el frontend, protegidos por RLS) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Frontend web (Vite solo expone variables con prefijo VITE_) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
VITE_API_BASE_URL=http://localhost:8080/api

# --- Backend Spring Boot: SECRETOS (solo servidor, jamás en frontend/desktop) ---
SUPABASE_SERVICE_ROLE_KEY=solo-backend-no-compartir
SUPABASE_JWT_SECRET=solo-backend-no-compartir
BACKEND_PORT=8080
BACKEND_ALLOWED_ORIGINS=http://localhost:5173

# --- Integración SUNAT (solo backend) ---
SUNAT_API_URL=https://URL-DEL-PROVEEDOR-SUNAT
SUNAT_API_TOKEN=solo-backend-no-compartir
SUNAT_TIMEOUT_MS=8000

# --- Aplicación de escritorio JavaFX (solo apunta al backend; sin secretos) ---
DESKTOP_API_BASE_URL=http://localhost:8080/api
